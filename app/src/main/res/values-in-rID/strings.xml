    <string name="visibility_description_excellent">Visibilitas sangat jernih; objek atau pemandangan yang jauh dapat terlihat dengan mudah</string>
    <string name="visibility_description_very_good">Kondisi sangat cerah</string>
    <string name="visibility_description_good">Kondisi cuaca cerah yang normal pada siang hari</string>
    <string name="visibility_description_moderate">Kondisi berkabut halus, membuat pemandangan yang jauh sedikit kurang jelas</string>
    <string name="visibility_description_poor">Jarak pandang berkurang drastis karena embun udara, asap, atau kabut</string>
    <string name="visibility_description_very_poor">Kabut tebal atau curah hujan tinggi yang dapat mengganggu aktivitas perjalanan</string>
    <string name="visibility_description_dense">Jarak pandang sangat terbatas, sehingga berisiko mengganggu lalu lintas kendaraan dan penerbangan</string>
